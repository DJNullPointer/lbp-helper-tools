{
  "manifest_version": 3,
  "name": "LBP Helper Tools",
  "description": "A set of internal helper tools for LBP workflow",
  "version": "1.0.3",
  "key": "",
  "update_url": "https://djnullpointer.github.io/lbp-helper-tools/update.xml",

  "action": {
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://app.propertymeld.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["cookies", "downloads", "tabs", "scripting", "clipboardRead", "clipboardWrite", "storage", "alarms", "identity"],

  "oauth2": {
    "client_id": "851690575009-3ed93maunp5tqb0c36c9v4rd9ejmbm9s.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },

  "host_permissions": [
    "https://app.propertyware.com/*",
    "https://api.propertyware.com/*",
    "https://app.propertymeld.com/*",
    "https://*.netlify.app/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*"
  ]
}
