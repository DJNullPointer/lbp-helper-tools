{
  "manifest_version": 3,
  "name": "LBP Helper Tools (Dev)",
  "description": "A set of internal helper tools for LBP workflow - Development Version",
  "version": "1.0.2",
  "update_url": "https://djnullpointer.github.io/lbp-helper-tools/update.xml",

  "action": {
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://app.propertymeld.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["cookies", "downloads", "tabs", "scripting", "clipboardRead", "clipboardWrite", "storage", "alarms"],

  "host_permissions": [
    "https://app.propertyware.com/*",
    "https://api.propertyware.com/*",
    "https://app.propertymeld.com/*",
    "https://*.netlify.app/*"
  ]
}
